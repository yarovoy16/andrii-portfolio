---
import '../styles/global.css';
const {lang='ru',title='Andrii Yarovyi',description='',section='home'}=Astro.props;
const ru=lang==='ru'; const base=`/${lang}/`; const other=Astro.url.pathname.replace(`/${lang}/`,ru?'/en/':'/ru/');
const nav=[['home',ru?'Главная':'Home','⌂'],['projects',ru?'Проекты':'Projects','▦'],['services',ru?'Услуги':'Services','◇'],['about',ru?'Обо мне':'About','○'],['contact',ru?'Контакты':'Contact','↗']];
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} — AI & Digital Solutions</title><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="alternate" hreflang={ru?'en':'ru'} href={other}/><link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">{ru?'К содержимому':'Skip to content'}</a><button class="menu" aria-label={ru?'Открыть меню':'Open menu'} aria-expanded="false">☰</button><aside><a class="brand" href={base}><b>ay<span>.</span></b><div>Andrii Yarovyi<small>AI & DIGITAL SOLUTIONS</small></div></a><div class="nav-label">{ru?'ПОРТФОЛИО':'PORTFOLIO'} / 2026</div><nav>{nav.map(([id,label,icon])=><a class:list={{active:section===id}} data-section={id} href={id==='home'?(section==='home'?'#home':base):id==='projects'?(section==='home'?'#projects':base+'projects/'):base+'#'+id}><span>{icon}</span>{label}</a>)}</nav><div class="sidebar-bottom"><div class="available"><i></i>{ru?'Открыт к сотрудничеству':'Open to collaboration'}</div><div class="languages"><a class:list={{selected:ru}} href={ru?Astro.url.pathname:other}>RU</a><a class:list={{selected:!ru}} href={ru?other:Astro.url.pathname}>EN</a></div><small>Independent developer<br/>Built with purpose.</small></div></aside><main id="main"><slot/><footer>© 2026 Andrii Yarovyi <span>AI & Digital Solutions</span></footer></main><dialog id="lightbox"><button class="close" aria-label={ru?'Закрыть':'Close'}>×</button><img alt=""/></dialog><script>
document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>a.addEventListener('click',()=>{a.hash=location.hash}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.body.classList.remove('menu-open');document.querySelector('.menu')?.setAttribute('aria-expanded','false')}});
const sections=document.querySelectorAll<HTMLElement>('main section[id]');if(sections.length){let ticking=false;const updateActive=()=>{const point=innerHeight*.38;let active=sections[0].id;for(const section of sections){if(section.getBoundingClientRect().top<=point)active=section.id;}const contact=document.querySelector<HTMLElement>('#contact');if(contact&&(contact.getBoundingClientRect().top<=innerHeight*.7||scrollY+innerHeight>=document.documentElement.scrollHeight-8))active='contact';document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]').forEach(a=>a.classList.toggle('active',a.dataset.section===active));ticking=false;};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(updateActive);ticking=true;}},{passive:true});addEventListener('resize',updateActive);updateActive();}

const menu=document.querySelector('.menu'); menu?.addEventListener('click',()=>{const open=document.body.classList.toggle('menu-open');menu.setAttribute('aria-expanded',String(open))});document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>document.body.classList.remove('menu-open')));
const box=document.querySelector<HTMLDialogElement>('#lightbox')!;document.querySelectorAll<HTMLButtonElement>('[data-image]').forEach(b=>b.addEventListener('click',()=>{const img=box.querySelector('img')!;img.src=b.dataset.image!;img.alt=b.dataset.alt||'';box.showModal()}));box.querySelector('button')?.addEventListener('click',()=>box.close());box.addEventListener('click',e=>{if(e.target===box)box.close()});
</script></body></html>
