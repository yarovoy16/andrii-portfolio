---
import Layout from '../../layouts/Layout.astro';import {projects} from '../../data/projects';
export function getStaticPaths(){return ['ru','en'].map(lang=>({params:{lang}}))}
const {lang}=Astro.params;const ru=lang==='ru';const t=(a,b)=>ru?a:b;
---
<Layout lang={lang} title={t('Превращаю идеи в цифровые продукты','Turning ideas into digital products')} description={t('Веб-приложения, автоматизация бизнеса, финансовые инструменты и AI-аватары. Портфолио Andrii Yarovyi.','Web applications, business automation, financial tools and AI avatars by Andrii Yarovyi.')}>
<div class="topline"><span>{t('НЕЗАВИСИМЫЙ РАЗРАБОТЧИК','INDEPENDENT DEVELOPER')}</span><span>DESIGN · BUILD · AUTOMATE</span></div>
<section class="hero" id="home"><div class="hero-copy"><div class="eyebrow"><i></i> AI & DIGITAL SOLUTIONS</div><p class="intro">Andrii Yarovyi</p><h1>{t('Превращаю идеи в','Turning ideas into')} <em>{t('цифровые продукты','digital products')}</em><span class="dot">.</span></h1><p class="lead">{t('Разрабатываю веб-приложения, системы учёта и инструменты автоматизации бизнеса с использованием современных AI-технологий. Помогу в создании AI-аватара.','I build web applications, business management systems, and automation tools powered by modern AI technologies. I can also help you create an AI avatar.')}</p><div class="actions hero-actions"><a class="button primary" href="#projects">{t('Посмотреть проекты','Explore projects')} <span>↗</span></a><a class="button" href="mailto:yarovoy.od@gmail.com?subject=Project%20inquiry">{t('Обсудить проект','Discuss a project')} →</a><a class="telegram-link" href="https://t.me/yarovoyandrei" target="_blank" rel="noopener noreferrer" aria-label={t('Написать в Telegram: @yarovoyandrei','Message on Telegram: @yarovoyandrei')}><svg class="telegram-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 4.2c.3-1.1-.4-1.6-1.4-1.2L2.7 9.7c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 1.7 5.3c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.2-2.2 4.6 3.4c.9.5 1.5.2 1.7-.8l2.9-14.4ZM8 12.2l10.3-6.5c.5-.3 1-.1.6.3L10.4 14l-.3 3.1L8 12.2Z"/></svg></a></div></div><div class="portrait"><img src="/assets/profile/andrii.webp" alt="Andrii Yarovyi" width="700" height="900" fetchpriority="high"/><div class="portrait-caption"><span><i></i> {t('От идеи до работающего решения','From idea to working product')}</span><b>Human insight.<br/>Digital possibilities.</b></div></div></section>
<div class="section-divider" aria-hidden="true"></div>
<section id="projects"><div class="section-heading"><div><div class="eyebrow">01 / {t('РЕАЛИЗОВАННЫЕ ПРОЕКТЫ','SELECTED WORK')}</div><h2>{t('Идеи, которые работают','Ideas put to work')}</h2></div><a class="text-link" href={`/${lang}/projects/`}>{t('Все проекты','All projects')} ↗</a></div><div class="project-grid">{projects.map((p,i)=><article class="project-card"><a class:list={['project-image',{'full-screenshot':p.id==='china-together'||p.id==='crm-china-tour'}]} href={`/${lang}/projects/${p.id}/`}><img src={'/assets/projects/'+p.image} alt={p.name} loading="lazy" width="1200" height="700"/><span class="image-arrow">↗</span></a><div class="card-body"><div class="card-kicker">0{i+1} <span>{t('РЕАЛИЗОВАН','COMPLETED')}</span></div><h3><a href={`/${lang}/projects/${p.id}/`}>{p.name}</a></h3><p>{p[lang].short}</p><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div><a class="detail" href={`/${lang}/projects/${p.id}/`}>{t('Подробнее','View project')} ↗</a></div></article>)}</div></section>
<section id="services"><div class="eyebrow">02 / {t('ЧЕМ МОГУ ПОМОЧЬ','WHAT I DO')}</div><h2>{t('Цифровые решения для ваших задач','Digital solutions for your business')}</h2><div class="services">{[[t('Веб-разработка','Web development'),t('Лендинги, корпоративные сайты, веб-приложения и удобные интерфейсы.','Landing pages, business websites, web applications and intuitive interfaces.'),'⌘'],[t('Бизнес и автоматизация','Business & automation'),t('CRM, системы учёта, внутренние панели и автоматизация процессов.','CRM, management tools, internal dashboards and process automation.'),'◇'],[t('Финансовые инструменты','Financial applications'),t('Калькуляторы, учёт расходов, аналитические панели и отчётность.','Calculators, expense tracking, analytics dashboards and reporting.'),'▤'],[t('AI-контент и аватары','AI content & avatars'),t('Цифровые двойники, видеопрезентации и многоязычный контент.','Digital twins, video presentations and multilingual content.'),'✧']].map(([name,desc,icon])=><article><span class="service-icon">{icon}</span><h3>{name}</h3><p>{desc}</p></article>)}</div></section>
<section id="about" class="about-profile"><div class="about-photo"><img src="/assets/profile/andrii.webp" alt="Andrii Yarovyi" width="800" height="1200" loading="lazy"/><div class="about-photo-label">Andrii Yarovyi<span>{t('Независимый разработчик','Independent developer')}</span></div></div><div class="about-copy"><div class="eyebrow">03 / {t('ОБО МНЕ','ABOUT ME')}</div><h2>{t('Опыт бизнеса.','Business experience.')}<br/><em>{t('Цифровое мышление.','Digital thinking.')}</em></h2><p>{t('Я Andrii Yarovyi, независимый разработчик цифровых решений. Создаю веб-приложения, инструменты учёта и автоматизации, которые помогают решать повседневные задачи бизнеса.','I’m Andrii Yarovyi, an independent digital solutions developer. I build web applications, management tools and automation that help businesses handle everyday tasks.')}</p><p class="about-highlight">{t('Я год жил в Китае и занимался организацией туров. Этот опыт стал основой моих проектов в сфере туризма: от учёта расходов до сайта путешествий и CRM для работы с заявками.','I lived in China for a year and organised tours. That experience shaped my travel projects: from expense management to a travel website and a CRM for handling enquiries.')}</p><p>{t('Соединяю понимание бизнес-процессов, работу с цифрами и AI-assisted development. Для меня хороший продукт — это понятный инструмент, которым удобно пользоваться каждый день.','I combine an understanding of business processes and financial logic with AI-assisted development. To me, a good product is a clear, practical tool that people can use every day.')}</p></div></section>
<section id="contact" class="contact"><div class="eyebrow">04 / {t('ДАВАЙТЕ СОЗДАДИМ ЧТО-ТО ПОЛЕЗНОЕ','LET’S BUILD SOMETHING USEFUL')}</div><h2>{t('Есть идея?','Have an idea?')} <em>{t('Давайте обсудим.','Let’s talk.')}</em></h2><p>{t('Расскажите о задаче — вместе определим, каким может быть решение.','Tell me what you need — we’ll explore what the right solution could look like.')}</p><div class="contact-methods"><a class="button primary" href="mailto:yarovoy.od@gmail.com">yarovoy.od@gmail.com ↗</a><a class="telegram-link" href="https://t.me/yarovoyandrei" target="_blank" rel="noopener noreferrer" aria-label={t('Написать в Telegram: @yarovoyandrei','Message on Telegram: @yarovoyandrei')}><svg class="telegram-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 4.2c.3-1.1-.4-1.6-1.4-1.2L2.7 9.7c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 1.7 5.3c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.2-2.2 4.6 3.4c.9.5 1.5.2 1.7-.8l2.9-14.4ZM8 12.2l10.3-6.5c.5-.3 1-.1.6.3L10.4 14l-.3 3.1L8 12.2Z"/></svg></a></div></section>
</Layout>
