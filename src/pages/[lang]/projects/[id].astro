---
import {avatarVideos} from '../../../data/avatar';
import Layout from '../../../layouts/Layout.astro';import {projects} from '../../../data/projects';
export function getStaticPaths(){return ['ru','en'].flatMap(lang=>projects.filter(p=>p.public).map(project=>({params:{lang,id:project.id},props:{project}})))}
const {lang}=Astro.params;const {project:p}=Astro.props;const ru=lang==='ru';const copy=p[lang];
---
<Layout lang={lang} title={p.name} description={copy.short} section="projects"><a class="text-link" href={`/${lang}/projects/`}>← {ru?'Все проекты':'All projects'}</a><div class="project-title"><div class="eyebrow">{ru?'РЕАЛИЗОВАННЫЙ ПРОЕКТ':'COMPLETED PROJECT'}</div><h1>{p.name}</h1><p class="lead">{copy.short}</p><div class="tags">{p.tags.map(tag=><span>{tag}</span>)}</div></div>{p.id==='ai-avatar' ? <div class="project-video"><video controls preload="none" poster={avatarVideos.poster} aria-label={ru?'Демонстрация цифрового аватара':'Digital avatar demonstration'}><source src={avatarVideos[lang] || avatarVideos.demo} type="video/mp4"/></video><p class="muted">{ru?'Демонстрационный ролик · HeyGen · Русская речь':'Demonstration video · HeyGen · Russian audio'}</p></div> : <button class="gallery-main" data-image={'/assets/projects/'+p.image} data-alt={p.name} aria-label={ru?'Увеличить скриншот':'Enlarge screenshot'}><img src={'/assets/projects/'+p.image} alt={p.name} width="1600" height="900"/></button>}<div class="about"><div><h2>{ru?'О проекте':'About the project'}</h2><p>{copy.description}</p>{p.tech.length>0&&<><h3>{ru?'Технологии':'Technology'}</h3><div class="tags">{p.tech.map(x=><span>{x}</span>)}</div></>}</div><div><h2>{ru?'Возможности':'Features'}</h2><ul class="features">{copy.features.map(x=><li>↗ {x}</li>)}</ul></div></div>{p.gallery.length>0 && <h2>{ru?'Интерфейс в деталях':'A closer look'}</h2>}<div class="gallery">{p.gallery.map((img,i)=><button data-image={'/assets/projects/'+img} data-alt={p.name} aria-label={`${ru?'Открыть изображение':'Open image'} ${i+1}`}><img src={'/assets/projects/'+img} alt={`${p.name} — ${ru?'интерфейс':'interface'} ${i+1}`} loading="lazy"/></button>)}</div><section class="contact"><h2>{ru?'Нужно похожее решение?':'Need a similar solution?'}</h2><div class="actions project-contact-actions"><a class="button primary" href="mailto:yarovoy.od@gmail.com?subject=Project%20inquiry">{ru?'Обсудить проект':'Discuss a project'} ↗</a><a class="telegram-link" href="https://t.me/yarovoyandrei" target="_blank" rel="noopener noreferrer" aria-label={ru?'Написать в Telegram: @yarovoyandrei':'Message on Telegram: @yarovoyandrei'}><svg class="telegram-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.8 4.2c.3-1.1-.4-1.6-1.4-1.2L2.7 9.7c-1.2.5-1.2 1.2-.2 1.5l4.5 1.4 1.7 5.3c.2.6.1.8.7.8.5 0 .7-.2 1-.5l2.2-2.2 4.6 3.4c.9.5 1.5.2 1.7-.8l2.9-14.4ZM8 12.2l10.3-6.5c.5-.3 1-.1.6.3L10.4 14l-.3 3.1L8 12.2Z"/></svg></a></div></section></Layout>
